PORT=3000

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

ANTHROPIC_API_KEY=

# Proyecto Supabase de Raabta (mismo que usan web/ y admin/) — se usa la
# service role key porque el bot escribe citas/clientes desde el backend,
# sin pasar por RLS de usuario final.
SUPABASE_URL=https://bowlmookhezvwwxofqoe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Fase 7: sync bidireccional con Google Calendar. PUBLIC_BASE_URL es la URL
# pública del bot (en Railway, https://bot.raabtastudio.com) — Google la
# necesita para saber adónde avisar. El token lo inventas tú, viaja en cada
# notificación de Google para confirmar que no es de otro origen.
PUBLIC_BASE_URL=https://bot.raabtastudio.com
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

BUSINESS_TIMEZONE=America/Lima
ESCALATION_PHONE=
SITE_CATALOG_URL=

# Fase 5: protección contra abuso y facturas sorpresa.
RATE_LIMIT_MAX_PER_MINUTE=20
DAILY_TOKEN_BUDGET=500000

# Fase 6 (CRM): orígenes del panel admin autorizados a llamar a /admin/*,
# separados por coma. Vacío = ningún origen cruzado permitido.
ADMIN_ORIGINS=https://raabta-admin-five.vercel.app,http://localhost:5173

# Notificaciones proactivas. Fuera de la ventana de 24h de Meta solo se
# puede escribir con una plantilla aprobada: este es su nombre exacto en el
# Administrador de WhatsApp, con 3 variables ({{1}} nombre, {{2}} servicio,
# {{3}} fecha y hora).
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es
# Respaldo si la tabla `configuracion` no responde. El valor real se edita
# desde el admin (Disponibilidad → Recordatorios), no acá.
RECORDATORIO_HORAS_ANTES=1

LOG_LEVEL=info
